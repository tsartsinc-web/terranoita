  },
  {
   "id": "load_content",
   "target": "Terraria.Main.OnEngineLoad (static event)",
   "patch": "call",
   "system": "noita_assets",
   "purpose": "Fired on the first menu frame, once the engine and graphics device are up: apply all our patches then (patching JIT-compiles Terraria methods, which runs static constructors such as CaptureManager's that need the game set up) and make the Noita textures.",
   "stage": "1a",
   "_unverified": {}
  },
