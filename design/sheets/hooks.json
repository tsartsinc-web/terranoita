{
 "sheet": "hooks",
 "description": "Every patch into Terraria. Runtime Harmony patches only; no game file is modified.",
 "key": "id",
 "columns": {
  "id": {
   "type": "string",
   "desc": "Hook id."
  },
  "target": {
   "type": "string",
   "desc": "Type:Method(signature) in Terraria.exe 1.4.5.8."
  },
  "patch": {
   "type": "enum",
   "values": [
    "prefix",
    "postfix",
    "transpiler",
    "call"
   ],
   "desc": "Harmony patch kind ('call' = we call it)."
  },
  "system": {
   "type": "ref",
   "ref": "systems",
   "desc": "Owning system."
  },
  "purpose": {
   "type": "string",
   "desc": "Why."
  },
