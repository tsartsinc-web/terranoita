<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Terranoita.Game.dll: the Harmony patches inside Terraria. Compiled against the player's own Terraria.exe,
    so it builds only on a PC with Terraria installed:  dotnet build -p:TerrariaDir="<Terraria folder>"
    Terraria.exe and XNA are referenced, never copied to the output.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Terranoita.Game</AssemblyName>
    <RootNamespace>Terranoita.Game</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
    <TerrariaDir Condition="'$(TerrariaDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Terraria</TerrariaDir>
    <XnaGac Condition="'$(XnaGac)' == ''">C:\Windows\Microsoft.NET\assembly\GAC_32</XnaGac>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Terranoita.Core\Terranoita.Core.csproj" />
    <Reference Include="Terraria">
      <HintPath>$(TerrariaDir)\Terraria.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework.Graphics\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game">
      <HintPath>$(XnaGac)\Microsoft.Xna.Framework.Game\v4.0_4.0.0.0__842cf8be1de50553\Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
