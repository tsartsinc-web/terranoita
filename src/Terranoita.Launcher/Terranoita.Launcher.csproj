<Project Sdk="Microsoft.NET.Sdk">
  <!-- Terranoita.exe: starts the player's Terraria.exe in-process with the mod. No compile-time Terraria reference. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Terranoita</AssemblyName>
    <RootNamespace>Terranoita.Launcher</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- lets the .NET Framework target build on any machine (including Linux CI) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
